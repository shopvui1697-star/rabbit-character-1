# LLM — 9Router (default) or AWS Bedrock
LLM_PROVIDER=9router
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=your-9router-api-key
DEFAULT_MODEL=Default

# Bedrock (only when LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
# DEFAULT_MODEL=bedrock:apac.anthropic.claude-3-5-sonnet-20241022-v2:0

# Services
USE_DUMMY_GOURMET=true  # Set to false to use Lovvit API
# Lovvit OpenSearch (restaurant only — movie search moved to MCP)
LOVVIT_API_KEY=your-lovvit-api-key
LOVVIT_RESTAURANT_SEARCH_URL=https://stg.opensearch.lovvit.jp/api/v1/restaurant/search

# Movie MCP server (database connection — passed to MCP subprocess)
# Format: postgresql://username:password@host:port/database
MOVIE_DATABASE_URL=postgresql://postgres:password@localhost:5432/rabbit3

# Observability (optional — leave empty to disable)
LOGFIRE_TOKEN=

# App
ENVIRONMENT=development
LOG_LEVEL=debug  # When "debug", step timings are written to backend/logs/trace_YYYYMMDD.log
